# =============================================================================
# 01_equilibrate.lmp
# Build Wurtzite GaN bulk, minimize, equilibrate at 300K with NPT
# Produces: GaN_0K_reference.data  (for W-S analysis)
#           GaN_equilibrated.data   (starting point for cascades)
# =============================================================================

units           metal
dimension       3
boundary        p p p
atom_style      atomic

# ---- Wurtzite GaN lattice (a=3.189 Å, c/a=1.626) ----
lattice custom 3.189 &
    a1 1.0 0.0 0.0 &
    a2 -0.5 0.8660254 0.0 &
    a3 0.0 0.0 1.626 &
    basis 0.0 0.0 0.0 &
    basis 0.666667 0.333333 0.375 &
    basis 0.333333 0.666667 0.5 &
    basis 0.0 0.0 0.875

region box block 0 24 0 24 0 16
create_box 2 box
create_atoms 1 box basis 1 1 basis 2 1 basis 3 2 basis 4 2

mass 1 69.723   # Ga
mass 2 14.007   # N

# ---- Interatomic Potential ----
pair_style      hybrid/overlay tersoff zbl 0.5 1.2
pair_coeff      * * tersoff GaN.tersoff Ga N
pair_coeff      1 1 zbl 31.0 31.0
pair_coeff      1 2 zbl 31.0 7.0
pair_coeff      2 2 zbl 7.0 7.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          1000
thermo_style    custom step temp press pe ke etotal lx ly lz pxx pyy pzz

# ---- Step 1: Energy Minimization ----
minimize 1.0e-8 1.0e-10 10000 100000
reset_timestep 0

# (0K reference will be saved AFTER NPT, so box dimensions match the cascade)

# ---- Step 2: NVT Thermalization ----
velocity all create 300.0 12345 mom yes rot yes dist gaussian
fix nvt1 all nvt temp 300.0 300.0 0.1
run 20000
unfix nvt1

# ---- Step 3: NPT Pressure Relaxation (aniso for wurtzite) ----
fix npt1 all npt temp 300.0 300.0 0.1 aniso 0.0 0.0 1.0
run 50000
unfix npt1

# ---- Step 4: Final NVT Equilibration ----
fix nvt2 all nvt temp 300.0 300.0 0.1
run 20000
unfix nvt2

# ---- Save equilibrated structure ----
write_data GaN_equilibrated.data
print ">>> Equilibration complete. Ready for cascade runs."

# ---- Step 5: Generate 0K reference for W-S analysis ----
# Quench to ~0K to freeze out thermal displacements, keeping the NPT-relaxed box
fix quench_ref all nvt temp 300.0 1.0 0.1
run 20000
unfix quench_ref

# Final energy minimization at the NPT box size
minimize 1.0e-8 1.0e-10 10000 100000

# Save the 0K reference — now has the SAME box as GaN_equilibrated.data
write_data GaN_0K_reference.data
print ">>> 0K reference (post-NPT box) saved."
